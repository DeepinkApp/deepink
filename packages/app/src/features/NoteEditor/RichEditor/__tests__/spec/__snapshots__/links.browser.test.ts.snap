exports[`Convert selected text into link 1`] = `"<div class="RichEditor css-1fa09jb" contenteditable="true" role="textbox" spellcheck="true" data-lexical-editor="true" style="user-select: text; white-space: pre-wrap; word-break: break-word;"><p class="RichEditor__paragraph" dir="auto"><span data-lexical-text="true">My </span><a href="https://example.com" rel="noreferrer" class="RichEditor__link"><span data-lexical-text="true">favorite</span></a><span data-lexical-text="true"> dish is cake</span></p></div>"`;

exports[`Insert link with no text 1`] = `"<div class="RichEditor css-1fa09jb" contenteditable="true" role="textbox" spellcheck="true" data-lexical-editor="true" style="user-select: text; white-space: pre-wrap; word-break: break-word;"><p class="RichEditor__paragraph" dir="auto"><span data-lexical-text="true">My favorite dish is cake </span><a href="https://example.com" class="RichEditor__link"><span data-lexical-text="true">https://example.com</span></a></p></div>"`;
